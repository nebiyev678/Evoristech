app EXECUTIVE-DASHBOARD (
    name: Executive Dashboard
    logo {
        type: text
        text: Executive Dashboard
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--styleA
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    javaScript {
        fileUrls: #APP_FILES#custom.js
    }
    css {
        fileUrls: #APP_FILES#custom.css
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    sessionStateProtection {
        checksumSalt: FA66DFCBBC44C9E9F809E83A3947B963A77F9D6ACB9960AB73FC7E3C82B87CFC
    }
    progressiveWebApp {
        installable: true
        themeColor: #0d6b6b
        backgroundColor: #ffffff
        appDescription: Evoris — İdarə panel
        appShortName: Evoris Dashboard
    }
    runtime {
        allowFeedback: true
    }

    substitution APP_NAME (
        value {
            staticValue: Executive Dashboard
        }
    )

)

